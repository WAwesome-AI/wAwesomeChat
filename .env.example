# Copy to .env and customize for your environment.

# Database configuration -----------------------------------------------------
# Full SQLAlchemy connection string. Leave blank to auto-create ./wawesomechat.db
WA_DB_URL=
# Optional sqlite filename if WA_DB_URL is empty
WA_DB_FILE=wawesomechat.db
# Log SQL statements (true/false)
WA_DB_ECHO=false
# Optional pool size (useful for Postgres deployments)
WA_DB_POOL_SIZE=

# AI provider defaults -------------------------------------------------------
WA_DEFAULT_MODEL=gpt-4o-mini
WA_REQUEST_TIMEOUT=60
# Optional JSON describing provider/model catalog overrides
WA_PROVIDER_CONFIG=
# Session key used for persisting transcripts
WA_CHAT_SESSION=local

# Auto-seed provider metadata/credentials (1 to enable)
WA_SEED_PROVIDERS=1
# Overwrite any existing stored secrets when seeding
WA_SEED_FORCE=0

# LiteLLM routing (set to 1 to enable noisy debug output)
WA_LITELLM_DEBUG=0

# Provider credentials -------------------------------------------------------
# Add credentials only to your local .env file; never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=
GEMINI_API_KEY=
XAI_API_KEY=

# LM Studio (local, OpenAI-compatible) ---------------------------------------
# Start the server from LM Studio's "Local Server" tab, then point this at it.
# LiteLLM reads these directly; no API key is required (it substitutes a fake
# one), but LM_STUDIO_API_BASE must include the /v1 suffix.
#
#   host / bare uv run        -> http://localhost:1234/v1
#   inside the podman container -> http://host.containers.internal:1234/v1
LM_STUDIO_API_BASE=
LM_STUDIO_API_KEY=
